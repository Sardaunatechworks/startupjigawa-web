# ==============================================================================
# STARTUP JIGAWA DIGITAL INNOVATION CENTER - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or .env.local and update values as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. STAFF CMS AUTHENTICATION & SECURITY (Enforced on /admin)
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@startupjigawa.com.ng"
ADMIN_PASSWORD="YourSecureAdminPasswordHere"
AUTH_SECRET="your-64-character-hex-auth-secret-here"

# ------------------------------------------------------------------------------
# 2. SITE URL & METADATA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Startup Jigawa Digital Innovation Center"

# ------------------------------------------------------------------------------
# 3. SUPABASE DATABASE & STORAGE (Configure when connecting to Supabase)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ------------------------------------------------------------------------------
# 4. SMTP EMAIL NOTIFICATIONS (Contact Form & Alerts)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="info@startupjigawa.com.ng"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="noreply@startupjigawa.com.ng"
